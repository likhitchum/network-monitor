[TEMPLATE]
APP_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
USER_EMAIL=user@example.com
USER_PASSWORD=change-this-user-password
DATABASE_PATH=/data/networkpulse.db
POLL_INTERVAL_SECONDS=60
# Granularity of the per-device scheduler tick (seconds)
CHECK_TICK_SECONDS=5
# Max devices checked simultaneously
MAX_CONCURRENT_CHECKS=10
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Days to keep metric rows (older rows are deleted automatically)
METRICS_RETENTION_DAYS=30
# How often the retention sweep runs (hours)
RETENTION_SWEEP_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
WEBHOOK_URL=
